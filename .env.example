# Supabase 项目配置（复制本文件为 .env.local 并填入你的 Supabase 项目信息）
# 以下两项为必填，用于数据库访问与 Supabase Auth (Google 登录)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 可选：服务端后台任务如配置 Service Role Key，将优先用于服务端持久化
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 系统默认 AI 模型配置（仅存服务端，用户未配置自定义 API Key 时自动使用并按 Token 扣费）
# 支持 provider: openai | gemini | anthropic | deepseek | openrouter | custom
SYSTEM_MODEL_PROVIDER=openai
SYSTEM_MODEL_BASE_URL=https://api.openai.com/v1
SYSTEM_MODEL_API_KEY=sk-your-system-api-key
SYSTEM_MODEL_NAME=gpt-6.2-sol
# SYSTEM_MODEL_MAX_ITERATIONS=12

# 可选：系统模型 Token 折算积分费率（新用户注册默认赠送 100 积分）
# 默认：正常输入 4000 / 缓存命中 40000 (0.1x) / 缓存写入 3200 (1.25x) / 输出 1000 tokens = 1 积分，单次最低 1 积分
# SYSTEM_MODEL_TOKENS_PER_CREDIT_INPUT=4000
# SYSTEM_MODEL_TOKENS_PER_CREDIT_CACHED_INPUT=40000
# SYSTEM_MODEL_TOKENS_PER_CREDIT_CACHE_WRITE=3200
# SYSTEM_MODEL_TOKENS_PER_CREDIT_OUTPUT=1000
# SYSTEM_MODEL_MIN_CREDITS_PER_RUN=1
